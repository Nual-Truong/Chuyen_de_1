        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\n\nentity \&quot;dim_date\&quot; as date {\n  * date_key : int &lt;&lt;PK&gt;&gt;\n  --\n  full_date : date\n  month : int\n  year : int\n}\n\nentity \&quot;dim_store\&quot; as store {\n  * store_key : int &lt;&lt;PK&gt;&gt;\n  --\n  ma_cua_hang : varchar\n  ten_cua_hang : varchar\n}\n\nentity \&quot;dim_customer\&quot; as customer {\n  * customer_key : int &lt;&lt;PK&gt;&gt;\n  --\n  sdt : varchar\n  phan_khuc : varchar\n  hieu_luc_tu : date &lt;&lt;SCD2&gt;&gt;\n  hieu_luc_den : date &lt;&lt;SCD2&gt;&gt;\n  la_ban_ghi_hien_tai : boolean &lt;&lt;SCD2&gt;&gt;\n}\n\nentity \&quot;dim_product\&quot; as product {\n  * product_key : int &lt;&lt;PK&gt;&gt;\n  --\n  ma_san_pham : varchar\n  ten_san_pham : varchar\n  nhom_san_pham : varchar\n}\n\nentity \&quot;fact_sales\&quot; as fact {\n  * order_key : varchar &lt;&lt;PK&gt;&gt;\n  * product_key : int &lt;&lt;PK, FK&gt;&gt;\n  --\n  date_key : int &lt;&lt;FK&gt;&gt;\n  store_key : int &lt;&lt;FK&gt;&gt;\n  customer_key : int &lt;&lt;FK&gt;&gt;\n  so_luong : int\n  don_gia : int\n  thanh_tien : int (measure)\n}\n\ndate ||..o{ fact\nstore ||..o{ fact\nproduct ||..o{ fact\ncustomer ||..o{ fact\n\nnote bottom of fact\n  GRAIN: \&quot;Một dòng trong fact_sales đại diện cho MỘT SẢN PHẨM \n  trong MỘT ĐƠN HÀNG tại MỘT CỬA HÀNG vào MỘT NGÀY.\&quot;\n  ---\n  * QUY ƯỚC: Các bảng Dimension đều có bản ghi Unknown (key = -1) \n  để xử lý dữ liệu nguồn không khớp.\nend note\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NhqXyQEB9xE75lIK7Wyi-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
