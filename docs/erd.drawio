        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\n\nentity \&quot;dim_date\&quot; as date {\n  * date_key : int &lt;&lt;PK&gt;&gt; -- Khóa đại diện ngày\n  --\n  full_date : date -- Ngày đầy đủ (YYYY-MM-DD)\n  month : int -- Tháng diễn ra giao dịch\n  year : int -- Năm diễn ra giao dịch\n}\n\nentity \&quot;dim_store\&quot; as store {\n  * store_key : int &lt;&lt;PK&gt;&gt; -- Khóa đại diện cửa hàng\n  --\n  ma_cua_hang : varchar -- Mã cửa hàng gốc từ hệ thống\n  ten_cua_hang : varchar -- Tên chi nhánh\n}\n\nentity \&quot;dim_customer\&quot; as customer {\n  * customer_key : int &lt;&lt;PK&gt;&gt; -- Khóa đại diện khách hàng\n  --\n  sdt : varchar -- Số điện thoại (đã che bảo mật)\n  phan_khuc : varchar -- Phân khúc khách hàng\n  hieu_luc_tu : date &lt;&lt;SCD2&gt;&gt; -- Ngày bắt đầu hiệu lực\n  hieu_luc_den : date &lt;&lt;SCD2&gt;&gt; -- Ngày kết thúc hiệu lực\n  la_ban_ghi_hien_tai : boolean &lt;&lt;SCD2&gt;&gt; -- Cờ đánh dấu bản ghi mới nhất\n}\n\nentity \&quot;dim_product\&quot; as product {\n  * product_key : int &lt;&lt;PK&gt;&gt; -- Khóa đại diện sản phẩm\n  --\n  ma_san_pham : varchar -- Mã sản phẩm gốc\n  ten_san_pham : varchar -- Tên sản phẩm\n  nhom_san_pham : varchar -- Phân loại (Ví dụ: Điện thoại, Phụ kiện)\n}\n\nentity \&quot;fact_sales\&quot; as fact {\n  * order_key : varchar &lt;&lt;PK&gt;&gt; -- Mã đơn hàng ghép\n  * product_key : int &lt;&lt;PK, FK&gt;&gt; -- Khóa ngoại sản phẩm\n  --\n  date_key : int &lt;&lt;FK&gt;&gt; -- Khóa ngoại ngày mua\n  store_key : int &lt;&lt;FK&gt;&gt; -- Khóa ngoại cửa hàng bán\n  customer_key : int &lt;&lt;FK&gt;&gt; -- Khóa ngoại khách mua\n  so_luong : int -- Số lượng bán\n  don_gia : int -- Đơn giá lúc bán\n  thanh_tien : int (measure) -- Tổng tiền thu được\n}\n\ndate ||..o{ fact\nstore ||..o{ fact\nproduct ||..o{ fact\ncustomer ||..o{ fact\n\nnote bottom of fact\n  &lt;b&gt;CHÚ THÍCH KÝ HIỆU:&lt;/b&gt;\n  - &lt;b&gt;&lt;&lt;PK&gt;&gt;&lt;/b&gt;: Khóa chính (Primary Key)\n  - &lt;b&gt;&lt;&lt;FK&gt;&gt;&lt;/b&gt;: Khóa ngoại (Foreign Key)\n  - &lt;b&gt;&lt;&lt;SCD2&gt;&gt;&lt;/b&gt;: Cột phục vụ Slowly Changing Dimension Loại 2\n  - &lt;b&gt;||..o{&lt;/b&gt; : Quan hệ 1 - Nhiều\n  ---\n  &lt;b&gt;MỨC CHI TIẾT (GRAIN):&lt;/b&gt;\n  Một dòng trong fact_sales đại diện cho MỘT SẢN PHẨM \n  trong MỘT ĐƠN HÀNG tại MỘT CỬA HÀNG vào MỘT NGÀY.\n  ---\n  &lt;b&gt;QUY ƯỚC BẢN GHI UNKNOWN:&lt;/b&gt;\n  Các bảng Dimension đều có bản ghi Unknown (key = -1) \n  để xử lý dữ liệu nguồn không khớp.\nend note\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="BaSFQrMlPQ3H9ypjH3ZK-1">
